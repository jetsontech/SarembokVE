# Sarembok_VE public edge.

{$SAREMBOK_SITE_ADDRESS} {
    encode gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Public edge liveness endpoint.
    handle /health {
        respond "OK" 200
    }

    # Sarembok Cloud Runtime (handles web app & WebSocket upgrade).
    handle {
        reverse_proxy sarembok-runtime:9000
    }
}
