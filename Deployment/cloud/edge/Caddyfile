{
    email admin@sarembok.com
}

sarembok.com, www.sarembok.com {
    # WebSocket and RPC/Session endpoints to backend runtime
    handle /ws {
        reverse_proxy sarembok-runtime:9000
    }
    handle /rpc {
        reverse_proxy sarembok-runtime:9000
    }
    handle /session {
        reverse_proxy sarembok-runtime:9000
    }
    handle /api/* {
        reverse_proxy sarembok-runtime:9000
    }
    handle /health {
        reverse_proxy sarembok-runtime:9000
    }
    handle /healthz {
        reverse_proxy sarembok-runtime:9000
    }
    handle /live/* {
        reverse_proxy sarembok-runtime:9000
    }

    # Authoritative Frontend UI directly from /srv with zero-caching
    handle {
        root * /srv
        header Cache-Control "no-cache, no-store, must-revalidate"
        header Pragma "no-cache"
        header Expires "0"
        try_files {path} /index.html
        file_server
    }
}

:80 {
    redir https://{host}{uri} permanent
}
