# Sarembok_VE public edge.

{$SAREMBOK_SITE_ADDRESS} {
    encode gzip

    # Public landing endpoint.
    handle / {
        respond "Sarembok VE Cloud Runtime — ONLINE" 200
    }

    # Public edge liveness endpoint.
    handle /health {
        respond "OK" 200
    }

    # Sarembok Cloud Runtime.
    # Caddy automatically supports WebSocket upgrades.
    handle {
        reverse_proxy sarembok-runtime:9000
    }
}
